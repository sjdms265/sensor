{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "dbhub", "--transport", "stdio", "--dsn", "postgresql://postgres:postgres@localhost:5432/sensormanager"]
    },
    "kafka": {
      "command": "kafka-mcp-server",
      "args": [],
      "env": {
        "KAFKA_BROKERS": "localhost:9092"
      }
    },
    "github": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<your-github-token>"
      }
    },
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server@latest"]
    },
    "maven": {
      "command": "npx",
      "args": ["-y", "maven-tools-mcp"]
    },
    "prometheus": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "PROMETHEUS_URL=http://localhost:9090", "ghcr.io/pab1it0/prometheus-mcp-server:latest"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "."]
    }
  }
}
